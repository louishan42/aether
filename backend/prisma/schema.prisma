generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Invoice {
  id             String    @id
  businessId     String
  customerId     String
  invoiceNumber  String
  customerName   String
  customerEmail  String
  amountSgd      Float
  dueDate        DateTime
  status         String
  reminderCount  Int       @default(0)
  lastReminderAt DateTime?
}

model FollowUpCustomer {
  id            String    @id
  businessId    String
  name          String
  email         String
  lastContactAt DateTime?
  notes         String    @default("")
  followUpCount Int       @default(0)
}

model Appointment {
  id            String   @id
  businessId    String
  customerName  String
  customerEmail String
  startsAt      DateTime
  status        String
  reminderCount Int      @default(0)
}

model AgentDraft {
  id          String   @id
  agent       String
  recordId    String
  invoiceId   String
  subject     String
  body        String
  status      String
  generatedAt DateTime
  rationale   String   @default("")
}

model ActionLog {
  id         String   @id
  agent      String
  agentRunId String?
  invoiceId  String?
  action     String
  result     String
  timestamp  DateTime
}

model DatasetImport {
  id         String   @id
  businessId String
  filename   String
  kind       String
  rowCount   Int
  importedAt DateTime
}

model BusinessProfile {
  businessId         String  @id
  name               String
  industry           String  @default("")
  employeeCount      Int     @default(0)
  annualRevenueSgd   Float   @default(0)
  isExporting        Boolean @default(false)
  usesDigitalTools   Boolean @default(false)
  hasGstRegistration Boolean @default(false)
}

model ReminderPolicy {
  businessId               String @id
  minimumOverdueDays       Int
  maxReminders             Int
  cooldownDays             Int
  customerFollowUpDays     Int
  appointmentReminderHours Int
}
